{
  "name": "anti-calote-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "seed": "tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "regua:once": "tsx src/infrastructure/workers/runReguaOnce.ts",
    "kill-port": "tsx scripts/kill-port.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "tunnel:stop": "tsx -e \"import ngrok from '@ngrok/ngrok'; ngrok.kill().then(() => console.log('Túneis ngrok encerrados'));\"",
    "dev:clean": "npm run kill-port && npm run dev",
    "start:ngrok": "concurrently \"npm run dev\" \"npm run tunnel\""
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
