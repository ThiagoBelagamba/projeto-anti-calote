# Backend
PORT=3333
TUNNEL_PORT=3333
NODE_ENV=development

# PostgreSQL (app)
DATABASE_URL=postgresql://postgres:postgres_senha_local@localhost:5432/anti_calote_db

# Usuário demo (criado pelo seed — não precisa alterar)
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Asaas Sandbox — conta turma: faculdadeprojeto510@gmail.com (ver docs/CONTA-COMPARTILHADA.md)
ASAAS_API_KEY=your_asaas_api_key
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=anti_calote_webhook_turma_2025
# Dev only: aceita webhooks sem token (não usar em produção)
ASAAS_WEBHOOK_SKIP_VERIFY=false

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
AUTHENTICATION_API_KEY=anti_calote_evo_secret_123
EVOLUTION_INSTANCE_NAME=projeto-teste

# Régua de cobrança (cron + Evolution)
REGUA_ENABLED=true
REGUA_CRON=0 9 * * *

# Ngrok — mesma conta turma; só um npm run tunnel por vez no plano free
NGROK_AUTHTOKEN=your_ngrok_token

# Planos academia (checkout)
PLAN_MONTHLY_VALUE=180
PLAN_ANNUAL_VALUE=1800

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333/api
